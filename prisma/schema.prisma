// StellarLend backend — Prisma schema.
//
// This is an intentionally minimal starting point, not a finished data model.
// It exists so the project has a real, migratable schema and so later issues
// (auth/sessions, indexer events, account profiles, etc.) have a place to add
// models rather than starting from a blank file. Expect it to change a lot.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A user of the protocol, identified by their Stellar account address.
/// Placeholder model — will likely grow auth/profile-related fields (or those
/// may move into dedicated models, e.g. AccountProfile) as auth issues land.
model Account {
  id             String   @id @default(cuid())
  stellarAddress String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  portfolioVersion Int    @default(1)

  positions Position[]

  @@map("accounts")
}

/// A single account's lending-protocol position for one asset/reserve
/// (collateral supplied and debt borrowed). Placeholder model — real fields
/// (health factor, interest accrual, liquidation state, etc.) land with the
/// lending API and indexer issues.
model Position {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id])
  asset            String
  collateralAmount Decimal  @default(0) @db.Decimal(38, 18)
  debtAmount       Decimal  @default(0) @db.Decimal(38, 18)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  version          Int      @default(1)

  @@unique([accountId, asset])
  @@index([asset])
  @@map("positions")
}

/// Durable state for an operation that may submit a transaction to Stellar.
/// The operation id is client-supplied and immutable; the payload hash makes
/// accidental or malicious reuse with different intent fail closed.
model TransactionOperation {
  id                 String    @id @default(cuid())
  operationId        String    @unique @db.VarChar(128)
  action             String    @db.VarChar(32)
  account            String    @db.VarChar(56)
  payloadHash        String    @db.Char(64)
  signedTransaction  String    @db.Text
  status             String    @db.VarChar(24)
  attemptCount       Int       @default(0)
  submissionLeaseToken String?  @db.VarChar(64)
  submissionLeaseUntil DateTime?
  ledgerTransaction  String?   @db.VarChar(128)
  failureCode        String?   @db.VarChar(64)
  failureMessage     String?   @db.VarChar(500)
  lastCheckedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@map("transaction_operations")
}

/// User Profile model storing core public and settings attributes.
/// Enforces schema-level database constraints (VARCHAR lengths) matching
/// application Zod validation rules as a defense-in-depth measure.
model Profile {
  userId      String   @id @db.VarChar(64)
  displayName String?  @db.VarChar(50)
  bio         String?  @db.VarChar(280)
  website     String?  @db.VarChar(2048)
  timezone    String?  @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("profiles")
}
