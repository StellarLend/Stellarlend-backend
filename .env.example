# Copy this file to .env and fill in real values for local development.
# See src/config/env.ts for validation rules — the server fails fast on boot
# if a required variable is missing or malformed.

# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (Prisma / Postgres) ---
# Matches the default credentials in docker-compose.yml.
DATABASE_URL=postgresql://stellarlend:stellarlend@localhost:5432/stellarlend?schema=public

# --- Stellar network ---
# "testnet" or "mainnet" (or "futurenet" for local contract development).
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# --- Request body limits ---
# Maximum allowed request body size. Accepts "100kb", "1mb", "500b", etc.
BODY_SIZE_LIMIT=100kb
# When true, mutating endpoints (POST/PUT/PATCH) reject non-JSON Content-Type with 415.
CONTENT_TYPE_ENFORCEMENT=true

# Address of the deployed StellarLend lending-pool Soroban contract.
LENDING_POOL_CONTRACT_ID=

# --- Auth (SEP-10 wallet auth + sessions) ---
# Home domain used in SEP-10 challenge transactions.
AUTH_HOME_DOMAIN=localhost:4000
# Base64 or plain secret key of the server's SEP-10 signing keypair. Never
# commit a real value; injected via your secret manager in deployed envs.
AUTH_SERVER_SIGNING_SECRET=
# Secret used to sign session JWTs.
AUTH_JWT_SECRET=change-me-in-every-real-environment

# --- Price oracle ---
ORACLE_PRIMARY_SOURCE=soroban
ORACLE_PRICE_STALENESS_THRESHOLD_SECONDS=120

# --- Caching (optional, used by indexer/oracle caching layers) ---
REDIS_URL=redis://localhost:6379

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000
